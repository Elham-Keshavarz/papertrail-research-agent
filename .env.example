# Optional overrides; copy to .env if desired. Do not commit .env.
PAPERTRAIL_MAX_PAPERS=5
PAPERTRAIL_MAX_RETRIES=2
PAPERTRAIL_REQUEST_TIMEOUT_SECONDS=20
PAPERTRAIL_MAX_PDF_PAGES=100
PAPERTRAIL_DATA_DIR=data
PAPERTRAIL_MODEL_NAME=gpt-4.1-mini
# Needed ONLY for --planner llm or --mode live (opt-in).
# Live requests can incur provider usage charges. --mode preview never uses an answer-model key.
PAPERTRAIL_OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=

# CPU math thread limit is configured *before* .env is loaded.
# Default is 1; set PAPERTRAIL_MATH_THREADS in PowerShell BEFORE starting Python to use 2-8.
# Setting PAPERTRAIL_LIMIT_MATH_THREADS=0 opts out (not recommended on low-memory machines).
# Do not rely on values here: .env loads too late for the early math-library bootstrap.
